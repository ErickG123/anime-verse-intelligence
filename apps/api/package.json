{
  "name": "@animeverse/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts up",
    "db:status": "tsx src/db/migrate.ts status",
    "db:generate": "drizzle-kit generate",
    "dataset:download": "tsx src/cli/dataset-download.ts",
    "dataset:import": "tsx src/cli/dataset-import.ts",
    "dataset:sync": "tsx src/cli/dataset-sync.ts"
  },
  "dependencies": {
    "@animeverse/contracts": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@fastify/type-provider-typebox": "^5.1.0",
    "@sinclair/typebox": "^0.34.28",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.41.0",
    "fastify": "^5.3.0",
    "pg": "^8.14.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.6",
    "tsx": "^4.19.3",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
