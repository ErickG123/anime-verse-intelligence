{
  "name": "anime-verse-intelligence",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @animeverse/api dev",
    "dev:web": "pnpm --filter @animeverse/web start",
    "build": "pnpm --filter @animeverse/contracts build && pnpm --filter @animeverse/api build && pnpm --filter @animeverse/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint \"apps/*/src/**/*.ts\" \"packages/*/src/**/*.ts\"",
    "test": "pnpm --filter @animeverse/contracts test && pnpm --filter @animeverse/api test && pnpm --filter @animeverse/web test",
    "test:e2e": "pnpm --filter @animeverse/web test:e2e",
    "test:e2e:smoke": "pnpm --filter @animeverse/web test:e2e:smoke",
    "audit:repo": "node tooling/validate-repo.mjs --mode=repo",
    "validate:docs": "node tooling/validate-repo.mjs --mode=docs",
    "validate:architecture": "node tooling/validate-repo.mjs --mode=arch",
    "validate:all": "pnpm audit:repo && pnpm validate:docs && pnpm validate:architecture && pnpm lint && pnpm build && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.53.0"
  },
  "lint-staged": {
    "*.{ts,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,scss,html,yaml,yml}": [
      "prettier --write"
    ]
  }
}
