# Database (PostgreSQL Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=animeverse
POSTGRES_USER=animeverse
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgresql://animeverse:change_me_local_only@localhost:5432/animeverse

# API (Fastify 5)
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:4200
ENABLE_SWAGGER=true
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=1 minute

# Web (Angular 22)
WEB_PORT=4200
API_BASE_URL=http://localhost:3000/api/v1

# Optional external enrichment providers (MUST remain false in MVP)
ENRICHMENT_ANILIST_ENABLED=false
ENRICHMENT_WIKIDATA_ENABLED=false
ENRICHMENT_MANGAUPDATES_ENABLED=false
ENRICHMENT_TMDB_ENABLED=false
